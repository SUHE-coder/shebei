.user-top { display: flex; align-items: center; }
.avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 92rpx; height: 92rpx; border-radius: 28rpx; background: #edf4ec; color: #176b53; font-size: 34rpx; font-weight: 600; }
.user-info { flex: 1; min-width: 0; margin-left: 20rpx; }
.user-name { display: block; font-size: 32rpx; font-weight: 600; word-break: break-all; }
.user-meta { display: flex; align-items: center; flex-wrap: wrap; margin-top: 12rpx; }
.user-meta .status { padding: 4rpx 12rpx; font-size: 21rpx; }
.id-label { margin-left: 12rpx; color: #78867d; font-size: 22rpx; }
.copy-button { min-height: 64rpx; margin-left: 12rpx; padding: 0 12rpx; color: #78867d; background: #f7f8f3; font-size: 22rpx; font-weight: 400; }
.description { display: block; margin-top: 24rpx; color: #78867d; font-size: 25rpx; line-height: 1.8; }
.user-card { margin-bottom: 34rpx; }
.workspace-entry { display: flex; align-items: center; justify-content: flex-start; width: 100%; padding: 28rpx; margin-bottom: 18rpx; border: 1rpx solid #e8ece5; border-radius: 24rpx; background: #fff; text-align: left; color: #20382f; }
.workspace-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: 22rpx; background: #edf4ec; color: #176b53; font-size: 44rpx; font-weight: 400; }
.workspace-text { flex: 1; min-width: 0; margin: 0 20rpx; }
.workspace-title { display: block; font-size: 30rpx; font-weight: 600; }
.workspace-hint { display: block; margin-top: 8rpx; color: #78867d; font-size: 23rpx; font-weight: 400; }
.workspace-arrow { color: #bdd8a8; font-size: 36rpx; }
.add-entry { color: #fff; background: #193e32; border-color: #193e32; }
.add-entry .workspace-icon { background: #315746; color: #d9ecc4; }
.add-entry .workspace-hint { color: #b4ccbb; }
.photo-icon { color: #946f40; background: #faf2e5; }
.account-actions { display: flex; align-items: center; justify-content: center; margin: 10rpx 0 30rpx; }
.account-actions .text-button { padding: 0 30rpx; font-weight: 400; }
.action-divider { width: 1rpx; height: 22rpx; background: #dce4d7; }
.logout-button { color: #a06b58; }
.login-card { padding: 44rpx 30rpx 32rpx; }
.login-symbol { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: 28rpx; background: #edf4ec; color: #176b53; font-size: 50rpx; }
.login-title { display: block; margin-top: 28rpx; font-size: 33rpx; font-weight: 600; }
.login-button { margin-top: 30rpx; }
.permission-card .section-title { margin-bottom: 22rpx; font-size: 28rpx; }
.permission-line { display: flex; align-items: flex-start; padding: 20rpx 0; border-top: 1rpx solid #edf0e9; color: #78867d; font-size: 24rpx; line-height: 1.7; }
.permission-line:last-child { padding-bottom: 0; }
.permission-name { flex-shrink: 0; width: 120rpx; color: #42564a; font-weight: 500; }
