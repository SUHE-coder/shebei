.profile-heading { padding: 10rpx 2rpx 32rpx; }
.profile-top { display: flex; align-items: center; justify-content: space-between; }
.profile-name { display: block; margin-top: 24rpx; font-size: 46rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.profile-code { display: flex; align-items: flex-start; margin-top: 18rpx; color: #78867d; font-size: 25rpx; word-break: break-all; }
.code-label { flex-shrink: 0; margin-right: 16rpx; color: #9ba69c; }
.info-row { display: flex; align-items: flex-start; padding: 23rpx 0; border-top: 1rpx solid #edf0e9; font-size: 27rpx; line-height: 1.7; }
.info-key { flex-shrink: 0; width: 132rpx; color: #78867d; }
.info-value { flex: 1; min-width: 0; text-align: right; word-break: break-all; }
.note-value { white-space: pre-wrap; text-align: left; }
.location-address { display: block; font-size: 27rpx; line-height: 1.7; word-break: break-all; }
.profile-map { width: 100%; height: 280rpx; margin-top: 22rpx; border-radius: 18rpx; overflow: hidden; }
.map-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; flex-wrap: wrap; }
.map-coordinates { color: #78867d; font-size: 22rpx; }
.map-link { min-height: 68rpx; padding: 0; color: #176b53; background: transparent; font-size: 23rpx; }
.album-button { margin-top: 24rpx; }
.album-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30rpx 0; color: #78867d; font-size: 26rpx; }
.album-empty-icon { margin-bottom: 12rpx; color: #aec1a3; font-size: 52rpx; }
.album-empty .hint { margin-top: 10rpx; text-align: center; }
