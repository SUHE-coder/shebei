page {
  --color-accent: #176b53;
  --color-ink: #20382f;
  --color-muted: #78867d;
  --color-line: #e8ece5;
  background: #f7f8f3;
  color: #20382f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}
.page { min-height: 100vh; padding: 32rpx 32rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.header { padding: 16rpx 2rpx 32rpx; }
.kicker { display: block; color: #176b53; font-size: 21rpx; letter-spacing: 3rpx; font-weight: 700; }
.title { display: block; margin-top: 12rpx; font-size: 46rpx; line-height: 1.25; font-weight: 700; letter-spacing: -1rpx; }
.subtitle { display: block; margin-top: 14rpx; color: #78867d; font-size: 26rpx; line-height: 1.65; }
.card { margin-bottom: 24rpx; padding: 30rpx; border: 1rpx solid #e8ece5; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(32, 56, 47, .025); }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.section-heading-main { display: flex; align-items: center; min-width: 0; }
.section-number { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin-right: 14rpx; border-radius: 14rpx; background: #edf4ec; color: #176b53; font-size: 23rpx; font-weight: 700; }
.section-title { display: block; font-size: 30rpx; font-weight: 600; }
.section-meta { color: #78867d; font-size: 23rpx; }
.muted { color: #78867d; }
.hint { display: block; color: #78867d; font-size: 23rpx; line-height: 1.65; margin-top: 16rpx; }
button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 0; padding: 0 24rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 600; line-height: 1.5; }
button::after { border: none; }
button[disabled] { opacity: .48; }
.button-active { opacity: .78; }
.primary { color: #fff; background: #176b53; }
.primary[disabled] { color: #fff; background: #176b53; }
.secondary { color: #335f4d; background: #edf4ec; }
.small-button { min-height: 76rpx; flex-shrink: 0; color: #176b53; background: #edf4ec; font-size: 25rpx; }
.text-button { min-height: 72rpx; color: #78867d; background: transparent; font-size: 25rpx; }
.label { display: block; margin-bottom: 12rpx; color: #42564a; font-size: 26rpx; font-weight: 500; }
.required { margin-left: 8rpx; color: #bf6650; }
input, textarea { box-sizing: border-box; width: 100%; padding: 20rpx 22rpx; border: 2rpx solid #e8ece5; border-radius: 16rpx; color: #20382f; background: #f9faf7; font-size: 28rpx; }
input { height: 88rpx; }
textarea { height: 180rpx; line-height: 1.6; }
.placeholder { color: #9ba69c; }
.field-focus { border-color: #176b53; background: #fff; }
.form-row { margin-bottom: 26rpx; }
.form-row:last-child { margin-bottom: 0; }
.code-row { display: flex; align-items: center; }
.code-row input { flex: 1; min-width: 0; }
.code-row button { margin-left: 14rpx; }
.error, .success { padding: 22rpx 24rpx; margin-bottom: 24rpx; border-radius: 18rpx; font-size: 25rpx; line-height: 1.65; overflow-wrap: break-word; }
.error { background: #fff0eb; color: #a24c36; border: 1rpx solid #f3ddd3; }
.success { background: #edf5eb; color: #176b53; border: 1rpx solid #d7e8d5; }
.state-card { padding: 70rpx 32rpx; text-align: center; }
.state-title { display: block; margin-top: 24rpx; font-size: 30rpx; font-weight: 600; }
.state-card button { margin-top: 28rpx; }
.state-symbol { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0 auto; border-radius: 28rpx; background: #edf4ec; color: #176b53; font-size: 42rpx; }
.gallery { display: flex; flex-wrap: wrap; margin: 20rpx -7rpx 0; }
.photo-tile { position: relative; width: calc(33.3333% - 14rpx); height: 188rpx; margin: 7rpx; overflow: hidden; border-radius: 18rpx; background: #edf1e9; }
.photo { display: block; width: 100%; height: 100%; }
.photo-state { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12rpx; box-sizing: border-box; color: #78867d; background: #edf1e9; font-size: 22rpx; text-align: center; }
.photo-state-icon { display: block; font-size: 34rpx; margin-bottom: 8rpx; }
.photo-number { position: absolute; left: 10rpx; bottom: 10rpx; padding: 2rpx 12rpx; border-radius: 9rpx; color: #fff; background: rgba(24, 48, 37, .56); font-size: 20rpx; }
.chevron { color: #9ba69c; font-size: 38rpx; }
.status { display: inline-flex; align-items: center; flex-shrink: 0; padding: 8rpx 18rpx; border-radius: 24rpx; color: #176b53; background: #edf5eb; font-size: 23rpx; font-weight: 500; }
.status-maintenance { color: #966424; background: #fcf2df; }
.status-retired { color: #78867d; background: #eef0ec; }
